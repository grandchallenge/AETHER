{
  "schema_version": "aether.repository-controls.v1",
  "repository": "grandchallenge/AETHER",
  "protected_branch": {
    "name": "main",
    "required_status_checks": [
      "Required CI gate",
      "Required Supply Chain gate",
      "policy / policy",
      "security / action-policy"
    ],
    "strict": true,
    "minimum_approvals": 0,
    "dismiss_stale_reviews": true,
    "require_code_owner_reviews": false,
    "require_last_push_approval": false,
    "required_conversation_resolution": true,
    "enforce_admins": true,
    "lock_branch": true,
    "allow_force_pushes": false,
    "allow_deletions": false
  },
  "governed_profile_source": {
    "repository": "grandchallenge/gcl-standards",
    "path": "fixtures/repository_profiles/AETHER.json",
    "commit_sha": "2801dcfd8d6fc647f85fcb0840ddb029c8df9dbb",
    "git_blob_sha1": "11eddb9be26051a74dbc7ccff00e792017ae5d2c",
    "profile": "provider",
    "risk_tier": "high",
    "claim_promotion_role": "none",
    "release_policy": "controlled_alpha"
  },
  "protection_model": {
    "classic_protection": "transition_only_optional_after_verified_ruleset",
    "default_branch_ruleset": {
      "name": "Provider profile - main",
      "target": "branch",
      "enforcement": "active",
      "include": ["~DEFAULT_BRANCH"],
      "bypass_actors": [],
      "required_rules": [
        "deletion",
        "non_fast_forward",
        "pull_request",
        "required_status_checks"
      ],
      "allowed_merge_methods": ["merge", "squash"]
    },
    "release_tag_ruleset": {
      "name": "Immutable release tags",
      "target": "tag",
      "enforcement": "active",
      "include": ["refs/tags/*"],
      "bypass_actors": [],
      "required_rules": ["deletion", "non_fast_forward"]
    }
  },
  "actions": {
    "allowed_actions": "selected",
    "sha_pinning_required": true,
    "github_owned_allowed": true,
    "verified_allowed": false,
    "patterns_allowed": [
      "leanprover/*",
      "ossf/*",
      "raven-actions/actionlint@*",
      "azohra/shell-linter@*",
      "release-drafter/release-drafter@*",
      "zulip/github-actions-zulip@*"
    ]
  },
  "repository_settings": {
    "has_wiki": false,
    "delete_branch_on_merge": true,
    "allow_merge_commit": true,
    "allow_squash_merge": true,
    "allow_rebase_merge": false
  },
  "custom_properties": {
    "authority_scope": "provider",
    "claim_promotion_role": "none",
    "constitutional_profile": "Provider",
    "public_programme": "true",
    "risk_tier": "high",
    "workflow_profile": "provider"
  },
  "security": {
    "dependabot_security_updates": "enabled",
    "secret_scanning": "enabled",
    "secret_scanning_push_protection": "enabled",
    "private_vulnerability_reporting": "enabled"
  },
  "environments": {
    "github-pages": {
      "minimum_reviewers": 0,
      "can_admins_bypass": false,
      "allowed_branches": ["main"]
    },
    "release": {
      "minimum_reviewers": 1,
      "can_admins_bypass": false,
      "allowed_branches": ["main"]
    }
  }
}
