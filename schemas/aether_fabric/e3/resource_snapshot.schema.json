{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://grandchallenge.dev/aether/schemas/aether_fabric/e3/resource_snapshot.schema.json",
  "title":"AETHER/FABRIC E3 ResourceSnapshot",
  "type":"object",
  "additionalProperties":false,
  "required":[
    "schema_version","protocol_family","protocol_major","protocol_minor","record_type",
    "snapshot_id","snapshot_digest","observed_at_unix_ms","observation_source",
    "canonicalization_version","resources"
  ],
  "properties":{
    "schema_version":{"const":"1.1"},
    "protocol_family":{"const":"aether-fabric"},
    "protocol_major":{"const":1},
    "protocol_minor":{"const":1},
    "record_type":{"const":"ResourceSnapshot"},
    "snapshot_id":{"type":"string","minLength":1,"maxLength":256},
    "snapshot_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "observed_at_unix_ms":{"type":"integer","minimum":0},
    "observation_source":{"type":"string","minLength":1,"maxLength":1024},
    "canonicalization_version":{"const":"gcl-cjson-set-v1"},
    "resources":{
      "type":"array",
      "items":{
        "type":"object","additionalProperties":false,
        "required":["resource_id","resource_class","capabilities","trust_zone","health","available_capacity","queue_depth","locality","scheduler_metadata"],
        "properties":{
          "resource_id":{"type":"string","minLength":1,"maxLength":256},
          "resource_class":{"type":"string","minLength":1,"maxLength":256},
          "capabilities":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":256}},
          "trust_zone":{"type":"string","minLength":1,"maxLength":256},
          "health":{"enum":["eligible","unavailable"]},
          "available_capacity":{
            "type":"object","additionalProperties":false,
            "required":["unit","total","available"],
            "properties":{
              "unit":{"const":"blocking_admission_slot"},
              "total":{"type":"integer","minimum":0},
              "available":{"type":"integer","minimum":0}
            }
          },
          "queue_depth":{"type":"integer","minimum":0},
          "locality":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":512}},
          "scheduler_metadata":{"type":"object","additionalProperties":{"type":"string"}}
        }
      }
    }
  }
}
