{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://grandchallenge.dev/aether/schemas/aether_fabric/e3/placement_decision.schema.json",
  "title":"AETHER/FABRIC E3 Placement Decision Evidence",
  "oneOf":[
    {"$ref":"#/$defs/selected"},
    {"$ref":"#/$defs/unavailable"}
  ],
  "$defs":{
    "base":{
      "type":"object",
      "required":[
        "schema_version","protocol_family","protocol_major","protocol_minor","record_type",
        "placement_decision_id","event_id","correlation_id","envelope_id","envelope_digest",
        "placement_constraint_id","placement_constraint_digest","resource_snapshot_id",
        "resource_snapshot_digest","scheduler_policy_id","scheduler_policy_digest",
        "selector_implementation_digest","decision_time_unix_ms","decision_input_digest",
        "control_state_ref","control_state_digest","authority_effect"
      ],
      "properties":{
        "schema_version":{"const":"1.1"},
        "protocol_family":{"const":"aether-fabric"},
        "protocol_major":{"const":1},
        "protocol_minor":{"const":1},
        "placement_decision_id":{"type":"string","minLength":1,"maxLength":256},
        "event_id":{"type":"string","minLength":1,"maxLength":256},
        "correlation_id":{"type":"string","minLength":1,"maxLength":256},
        "envelope_id":{"type":"string","minLength":1,"maxLength":256},
        "envelope_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "placement_constraint_id":{"type":"string","minLength":1,"maxLength":256},
        "placement_constraint_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "resource_snapshot_id":{"type":"string","minLength":1,"maxLength":256},
        "resource_snapshot_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "scheduler_policy_id":{"type":"string","minLength":1,"maxLength":256},
        "scheduler_policy_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "selector_implementation_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "decision_time_unix_ms":{"type":"integer","minimum":0},
        "decision_input_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "control_state_ref":{"type":"string","minLength":1,"maxLength":256},
        "control_state_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
        "authority_effect":{"const":"none"}
      }
    },
    "selected":{
      "allOf":[
        {"$ref":"#/$defs/base"},
        {
          "type":"object","additionalProperties":false,
          "required":["record_type","resource_id","eligibility_evidence","selection_rank"],
          "properties":{
            "schema_version":{"const":"1.1"},"protocol_family":{"const":"aether-fabric"},"protocol_major":{"const":1},"protocol_minor":{"const":1},
            "record_type":{"const":"PlacementSelected"},
            "placement_decision_id":{"type":"string"},"event_id":{"type":"string"},"correlation_id":{"type":"string"},"envelope_id":{"type":"string"},
            "envelope_digest":{"type":"string"},"placement_constraint_id":{"type":"string"},"placement_constraint_digest":{"type":"string"},
            "resource_snapshot_id":{"type":"string"},"resource_snapshot_digest":{"type":"string"},"scheduler_policy_id":{"type":"string"},
            "scheduler_policy_digest":{"type":"string"},"selector_implementation_digest":{"type":"string"},"decision_time_unix_ms":{"type":"integer"},
            "decision_input_digest":{"type":"string"},"control_state_ref":{"type":"string"},"control_state_digest":{"type":"string"},"authority_effect":{"const":"none"},
            "resource_id":{"type":"string","minLength":1,"maxLength":256},
            "eligibility_evidence":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":512}},
            "selection_rank":{"type":"integer","minimum":1}
          }
        }
      ]
    },
    "unavailable":{
      "allOf":[
        {"$ref":"#/$defs/base"},
        {
          "type":"object","additionalProperties":false,
          "required":["record_type","reason"],
          "properties":{
            "schema_version":{"const":"1.1"},"protocol_family":{"const":"aether-fabric"},"protocol_major":{"const":1},"protocol_minor":{"const":1},
            "record_type":{"const":"PlacementUnavailable"},
            "placement_decision_id":{"type":"string"},"event_id":{"type":"string"},"correlation_id":{"type":"string"},"envelope_id":{"type":"string"},
            "envelope_digest":{"type":"string"},"placement_constraint_id":{"type":"string"},"placement_constraint_digest":{"type":"string"},
            "resource_snapshot_id":{"type":"string"},"resource_snapshot_digest":{"type":"string"},"scheduler_policy_id":{"type":"string"},
            "scheduler_policy_digest":{"type":"string"},"selector_implementation_digest":{"type":"string"},"decision_time_unix_ms":{"type":"integer"},
            "decision_input_digest":{"type":"string"},"control_state_ref":{"type":"string"},"control_state_digest":{"type":"string"},"authority_effect":{"const":"none"},
            "reason":{"type":"string","minLength":1,"maxLength":512}
          }
        }
      ]
    }
  }
}
