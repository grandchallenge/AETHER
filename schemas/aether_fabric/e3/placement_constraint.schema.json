{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandchallenge.dev/aether/schemas/aether_fabric/e3/placement_constraint.schema.json",
  "title": "AETHER/FABRIC E3 PlacementConstraintSet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version","protocol_family","protocol_major","protocol_minor","record_type",
    "constraint_set_id","envelope_id","envelope_digest","correlation_id",
    "resource_requirements","max_snapshot_age_ms","decision_time_unix_ms",
    "control_state_ref","control_state_digest","source_authority_ref","authority_effect"
  ],
  "properties": {
    "schema_version": {"const":"1.1"},
    "protocol_family": {"const":"aether-fabric"},
    "protocol_major": {"const":1},
    "protocol_minor": {"const":1},
    "record_type": {"const":"PlacementConstraintSet"},
    "constraint_set_id": {"type":"string","minLength":1,"maxLength":256},
    "envelope_id": {"type":"string","minLength":1,"maxLength":256},
    "envelope_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "correlation_id": {"type":"string","minLength":1,"maxLength":256},
    "resource_requirements": {
      "type":"object","additionalProperties":false,
      "required":["capacity_unit","minimum_capacity_units"],
      "properties":{
        "capacity_unit":{"const":"blocking_admission_slot"},
        "minimum_capacity_units":{"type":"integer","minimum":1}
      }
    },
    "max_snapshot_age_ms":{"type":"integer","minimum":0},
    "decision_time_unix_ms":{"type":"integer","minimum":0},
    "control_state_ref":{"type":"string","minLength":1,"maxLength":256},
    "control_state_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "source_authority_ref":{"type":"string","minLength":1,"maxLength":2048},
    "authority_effect":{"const":"mechanical_narrowing_only"},
    "eligible_resource_classes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":256}},
    "trust_zones":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":256}},
    "required_capabilities":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":256}},
    "locality_constraints":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":512}}
  }
}
